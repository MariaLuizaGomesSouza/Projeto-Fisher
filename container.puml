@startuml container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_OUTLINE()

Person(produtor, "Produtor Rural / Piscicultor", "Usuário responsável por cadastrar tanques, biometrias e consultar a quantidade de ração diária.")

System_Boundary(c1, "Sistema de Gestão de Piscicultura - Fisher") {
    Container(web_app, "Aplicação Web / Frontend", "HTML, CSS, JavaScript", "Interface interativa para registro de amostras de peso, tanques e visualização dos cálculos de ração.")
    
    Container(backend, "Servidor Backend", "Python / Flask", "Processa as regras de negócio, calcula a biomassa total, estima a ração diária necessária e gerencia o CRUD.")
    
    ContainerDb(database, "Banco de Dados", "SQL (SQLite/PostgreSQL)", "Armazena registros de tanques, lotes de peixes, históriico de biometria (pesagens) e parâmetros de arraçoamento.")
}

Rel(produtor, web_app, "Informa peso amostral, quantidade de peixes e consulta ração", "HTTPS / Navegador")
Rel(web_app, backend, "Envia dados de biometria e solicita cálculos", "JSON / HTTP REST API")
Rel(backend, database, "Lê e grava dados de biometria, tanques e ração", "SQL / ORM")

@enduml