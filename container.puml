@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Diagrama de Contêineres - Sistema de Gestão de Piscicultura

Person(usuario, "Produtor / Piscicultor", "Gerencia os tanques, monitora a biometria e o nível de ração.")

System_Boundary(sistema_piscicultura, "Sistema de Piscicultura") {
    Container(web_app, "Aplicação Web / Frontend", "React / JavaScript", "Fornece a interface visual para o usuário acompanhar dados e alertas.")
    Container(api, "API Backend", "Python / Flask", "Processa as regras de negócio, lógica de biometria e requisições.")
    ContainerDb(banco, "Banco de Dados", "PostgreSQL", "Armazena dados dos usuários, tanques, sensores e histórico de biometria.")
}

System_Ext(sensor_externo, "Sensores IoT / Qualidade da Água", "Dispositivos físicos", "Envia dados de temperatura e oxigênio dissolvido.")

Rel(usuario, web_app, "Usa", "HTTPS")
Rel(web_app, api, "Faz requisições para", "JSON / HTTPS")
Rel(api, banco, "Lê e grava dados em", "SQL")
Rel(sensor_externo, api, "Envia telemetria para", "API / MQTT")

@enduml