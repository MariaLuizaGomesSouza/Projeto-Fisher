@startuml Diagrama_de_Container_Fisher
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

SHOW_PERSON_OUTLINE()

title Diagrama de Containers - Projeto-Fisher (Estrutura Atual)

' Pessoas / Atores
Person(produtor, "Produtor Rural / Piscicultor", "Acessa o sistema para registrar tanques, biometrias e consultar a quantidade de ração diária.")

' Limite da Aplicação
System_Boundary(sistema, "Projeto-Fisher") {
    Container(frontend, "Interface Web (Templates)", "HTML / CSS / Jinja2", "Páginas visuais renderizadas pelo servidor (base.html, tanques.html, cadastrar_tanque.html) para interação com o usuário.")
    
    Container(app_backend, "Aplicação Backend (app.py)", "Python / Flask", "Ponto central do sistema. Gerencia as rotas, renderiza as telas, processa a biomassa e os dados de cadastro de tanques.")
    
    ContainerDb(database, "Banco de Dados", "SQLite / PostgreSQL", "Armazena registros de tanques, lotes de peixes, histórico de biometria e parâmetros de arraçoamento.")
}

' Relacionamentos
Rel(produtor, frontend, "Acessa as páginas e preenche formulários", "Navegador Web / HTTPS")
Rel(frontend, app_backend, "Envia requisições e dados inseridos", "HTTP / Jinja2")
Rel(app_backend, database, "Consulta e salva dados dos tanques e pesagens", "SQL / ORM")

@enduml