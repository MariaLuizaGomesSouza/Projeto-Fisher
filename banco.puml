@startuml

hide circle
skinparam linetype ortho

entity "Produtor" {
  * id : int <<PK>>
  --
  nome : varchar
  cpf : varchar
  telefone : varchar
}

entity "Tanque" {
  * id : int <<PK>>
  --
  nome : varchar
  capacidade : int
  produtor_id : int <<FK>>
}

entity "Pesagem" {
  * id : int <<PK>>
  --
  data : date
  pesoKg : decimal
  tanque_id : int <<FK>>
}

entity "Insumos" {
  * id : int <<PK>>
  --
  nome : varchar
  quantidade : int
  valor : decimal
}

Produtor ||--o{ Tanque : possui
Tanque ||--o{ Pesagem : registra
Produtor ||--o{ Insumos : gerencia

@enduml